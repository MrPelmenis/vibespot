# ── CoolSpot environment ───────────────────────────────────────────────────────
# Copy to .env.local for local development.  NEVER commit a real .env file.
#
# Which of these are SECRET?
#   AUTH_SECRET            — server only. Rotating it signs everyone out.
#   GOOGLE_CLIENT_SECRET   — server only. This is the value the legacy repo leaked
#                            into public/ config.js.
#   GEOAPIFY_API_KEY       — server only; proxied through our own route so the key
#                            is never sent to the browser.
#   NEXT_PUBLIC_MAPTILER_KEY — not a secret (it ships to the browser by design), but
#                            it is still read from env so each environment can use its
#                            own key and it stays out of the repo.
#
# Env vars that are safe to expose must be prefixed NEXT_PUBLIC_ and are inlined into
# the client bundle. Everything above is deliberately server-side only.

# ── Application ───────────────────────────────────────────────────────────────
# Canonical origin. Used for metadataBase, robots.txt, sitemap.xml and OAuth redirects.
SITE_URL=http://localhost:3000
NODE_ENV=development

# ── Session signing ──────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with:  openssl rand -base64 32
AUTH_SECRET=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
# Authorised redirect URI must include, for each environment:
#   http://localhost:3000/api/auth/google/callback
#   https://coolspot.lv/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Postgres ─────────────────────────────────────────────────────────────────
# Added in Phase 2. Local: Postgres on localhost. Production: same box, systemd service.
DATABASE_URL=postgres://coolspot:CHANGE_ME@localhost:5432/coolspot

# ── Geocoding (Phase 2) ──────────────────────────────────────────────────────
# Geoapify primary (free tier allows commercial use, no card, 3000 credits/day).
# LocationIQ is the fallback, and Photon self-hosted is the long-term option.
GEOAPIFY_API_KEY=
LOCATIONIQ_API_KEY=

# ── Map tiles (Phase 2) ──────────────────────────────────────────────────────
# MapTiler style URL to start; a self-hosted Protomaps PMTiles file is the later path.
# Without a key the map falls back to OpenStreetMap raster tiles (with attribution).
NEXT_PUBLIC_MAPTILER_KEY=
# Optional MapTiler style id. Defaults to `streets-v2`.
NEXT_PUBLIC_MAPTILER_MAP=streets-v2

# ── Media (Phase 2) ──────────────────────────────────────────────────────────
# Where uploaded media and generated derivatives live. Must be writable by the app
# user, and must be backed up alongside the database.
MEDIA_ROOT=./data/media
# ffmpeg/ffprobe binary paths — set these if they are not on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Legacy import (scripts/import-legacy.ts) ─────────────────────────────────
# Only needed for the one-off data migration out of the old SQLite app. Every spot,
# image and user in the source database is imported; comments and likes are not.
# Both are auto-detected (./main_db.db and ./legacy_uploads/spot_images), and the
# script tells you which it picked. Set them to be explicit:
LEGACY_DB=./main_db.db
LEGACY_UPLOADS=./legacy_uploads/spot_images
# Alternative to the two above: the root of the old repo, used for auto-detection.
# LEGACY_DIR=../coolspot
